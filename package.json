{
  "name": "wot-agent-communication",
  "version": "1.0.0",
  "description": "This project is a mashup of a [CArtAgO](https://sourceforge.net/projects/cartago/) artifact for [JaCoMo](https://github.com/jacamo-lang/jacamo) and [node-wot](https://www.thingweb.io/). \r It enables agents to communicate via Web of Things protocols and discover other agents and what they are capable of using a Thing Description.",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "generate:robot": "node ./src/generator/generateRobot.js",
    "delete:robot": "node ./src/generator/deleteRobot.js",
    "archive:robot": "node ./src/generator/archiveRobot.js",
    "robot:pipeline": "node ./src/generator/robwotBridge.js",
    "robot:inspect-tool": "node ./src/generator/inspectToolFrame.js",
    "robot:serve": "node ./src/generator/lowerThingServer.js",
    "robot:serve:isolated": "node ./src/generator/lowerThingServer.js --isolated-cores",
    "robot:agent": "node ./src/generator/agentThingServer.js",
    "robot:cleanup": "node ./src/generator/cleanupRobotPorts.js",
    "interaction:estimate": "node ./src/generator/interactionSpace.js",
    "interaction:overlap": "node ./src/generator/workspaceOverlap.js",
    "motion:report": "node ./src/generator/motionReport.js",
    "motion:observe": "node ./src/generator/motionObserver.js",
    "interaction:computed": "node ./src/generator/computeLog.js",
    "eval:e1:sample": "node ./src/eval/e1Convergence.js sample",
    "eval:e1:analyze": "node ./src/eval/e1Convergence.js analyze",
    "eval:e2": "node ./src/eval/e2CollisionCost.js",
    "eval:e3": "node ./src/eval/e3SafetyPipeline.js run",
    "eval:e3:analyze": "node ./src/eval/e3SafetyPipeline.js analyze",
    "eval:e4": "node ./src/eval/e4Smoothness.js run",
    "eval:e4:analyze": "node ./src/eval/e4Smoothness.js analyze",
    "eval:e5": "node ./src/eval/e5Neighbours.js analyze",
    "eval:e6": "node ./src/eval/e6ComputationSaved.js analyze",
    "eval:e7e8": "node ./src/eval/e7VoxelSize.js analyze",
    "eval:e9": "node ./src/eval/e9HandoverPoint.js analyze",
    "eval:e9:run": "node ./src/eval/e9HandoverPoint.js run",
    "eval:e10": "node ./src/eval/e10Arbitration.js run",
    "eval:e10:analyze": "node ./src/eval/e10Arbitration.js analyze",
    "test": "node --test src/generator/*.test.js src/generator/core/*.test.js src/eval/*.test.js",
    "interaction:refresh": "node ./src/generator/interactionSpace.js --manifest generated/robots/Robot1/manifest.json --all-pairs",
    "interaction:visual": "node ./src/generator/robwotBridge.js --manifests generated/robots/Robot1/manifest.json,generated/robots/Robot2/manifest.json,generated/robots/Robot3/manifest.json --update-shared-space-visual",
    "eval:e11": "node ./src/eval/e11Scaling.js watch",
    "eval:e11:launch": "node ./src/eval/e11Scaling.js launch",
    "eval:e11:analyze": "node ./src/eval/e11Scaling.js analyze",
    "eval:e12": "node ./src/eval/e12Principal.js watch",
    "eval:e12:launch": "node ./src/eval/e12Principal.js launch",
    "eval:e12:deliver": "node ./src/eval/e12Principal.js deliver",
    "eval:e12:verify": "node ./src/eval/e12Principal.js verify",
    "eval:e12:analyze": "node ./src/eval/e12Principal.js analyze",
    "eval:e13": "node ./src/eval/e13Rerouting.js watch",
    "eval:e13:launch": "node ./src/eval/e13Rerouting.js launch",
    "eval:e13:killed": "node ./src/eval/e13Rerouting.js killed",
    "eval:e13:deliver": "node ./src/eval/e13Rerouting.js deliver",
    "eval:e13:status": "node ./src/eval/e13Rerouting.js status",
    "eval:e13:discard": "node ./src/eval/e13Rerouting.js discard",
    "eval:e13:verify": "node ./src/eval/e13Rerouting.js verify",
    "eval:e13:analyze": "node ./src/eval/e13Rerouting.js analyze"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-wot/binding-coap": "^0.8.16",
    "@node-wot/binding-http": "^0.8.16",
    "@node-wot/core": "^0.8.16",
    "websocket-as-promised": "^2.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "ajv": "^8.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
