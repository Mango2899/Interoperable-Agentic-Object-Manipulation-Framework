// Generated by src/generator/generateRobot.js
// Phase one scaffold for the mobile platform YouBot.
// Base poses are (x meter, y meter, theta degree); arm positions are cartesian
// (x, y, z meter) relative to the platform base.

baseHomePose(0, 0, 0).
basePickPose(0.9, 0, 0).
baseDropPose(0, 0.9, 90).
armGripPosition(0.45, 0.02, 0.33).
armCarryPosition(0.4, 0.02, 0.53).

+addAchieveGoal2Agent(TermString): true <-
    .print("Received external achieve request: ", TermString);
    .term2string(X, TermString);
    !X.

!init.

+!init: true <-
    .print("Initializing YouBot mobile platform agent");
    +myStatus(idle);
    .wait(1500);
    !goHome;
    !navDemo.

+!navDemo: basePickPose(X, Y, Theta) <-
    .print("Starting navigation demo for YouBot");
    !goTo(X, Y, Theta);
    .wait(500);
    !goHomeBase;
    .print("Navigation demo finished for YouBot").

+!transportDemo: true <-
    .print("Starting transport demo for YouBot");
    !pick;
    !drop;
    !goHomeBase;
    !goHome;
    .print("Transport demo finished for YouBot").

+!pick: basePickPose(BX, BY, BTheta) & armGripPosition(X, Y, Z) & armCarryPosition(CX, CY, CZ) <-
    !goTo(BX, BY, BTheta);
    !moveArmTo(X, Y, Z);
    !closeGripper;
    .wait(500);
    !moveArmTo(CX, CY, CZ).

+!drop: baseDropPose(BX, BY, BTheta) & armGripPosition(X, Y, Z) & armCarryPosition(CX, CY, CZ) <-
    !goTo(BX, BY, BTheta);
    !moveArmTo(X, Y, Z);
    !openGripper;
    .wait(500);
    !moveArmTo(CX, CY, CZ).

+!goTo(X, Y, Theta): true <-
    .abolish(arrivedAt(_, _, _));
    .abolish(motionFailed(_));
    -myStatus(idle);
    +myStatus(navigating);
    wotAchieve("ownLayer1", "goTo", [X, Y, Theta]);
    .wait(6000);
    if (motionFailed(Reason)) {
        .print("Navigation failed for YouBot: ", Reason);
        -myStatus(navigating);
        +myStatus(broken);
        .fail
    };
    -myStatus(navigating);
    +myStatus(idle).

+!goHomeBase: baseHomePose(X, Y, Theta) <-
    !goTo(X, Y, Theta).

+!moveArmTo(X, Y, Z): true <-
    .abolish(movedTo(_, _, _));
    .abolish(movedTo(_));
    .abolish(motionFailed(_));
    -myStatus(idle);
    +myStatus(moving);
    wotAchieve("ownLayer1", "moveArmTo", [X, Y, Z]);
    .wait(3500);
    if (motionFailed(Reason)) {
        .print("Arm motion failed for YouBot: ", Reason);
        -myStatus(moving);
        +myStatus(broken);
        .fail
    };
    -myStatus(moving);
    +myStatus(idle).

+!closeGripper: true <-
    .abolish(gripFailed(_));
    .abolish(grippedObject(_));
    wotAchieve("ownLayer1", "closeGripper", []);
    .wait(1000);
    if (gripFailed(Reason)) {
        .print("Close gripper failed for YouBot: ", Reason);
        .fail
    };
    -myStatus(idle);
    +myStatus(holdingObject).

+!openGripper: true <-
    .abolish(gripFailed(_));
    wotAchieve("ownLayer1", "openGripper", []);
    .wait(1000);
    if (gripFailed(Reason)) {
        .print("Open gripper failed for YouBot: ", Reason);
        .fail
    };
    -myStatus(holdingObject);
    +myStatus(idle).

+!goHome: homeJoints(HomeJoints) <-
    .abolish(movedTo(_));
    .abolish(motionFailed(_));
    -myStatus(idle);
    +myStatus(moving);
    wotAchieve("ownLayer1", "goHomeJoints", HomeJoints);
    .wait(3500);
    if (motionFailed(Reason)) {
        .print("Arm home motion failed for YouBot: ", Reason);
        -myStatus(moving);
        +myStatus(broken);
        .fail
    };
    -myStatus(moving);
    +myStatus(idle).

+!goHome: armCarryPosition(X, Y, Z) <-
    !moveArmTo(X, Y, Z).

-!goTo(X, Y, Theta): motionFailed(Reason) <-
    .print("Navigation failed for YouBot: ", Reason);
    -myStatus(navigating);
    +myStatus(broken).

-!moveArmTo(X, Y, Z): motionFailed(Reason) <-
    .print("Arm motion failed for YouBot: ", Reason);
    -myStatus(moving);
    +myStatus(broken).

+?state(MessageID): myStatus(Status) <-
    wotSendTestResponse(Status, MessageID).

@[wotExchangable]
+!driveTo(X, Y, Theta): true <-
    !goTo(X, Y, Theta).

@[wotExchangable]
+!returnHome: true <-
    !goHomeBase.

@[wotExchangable]
+!transport: true <-
    !transportDemo.

@[wotExchangable]
+!gripObject: true <-
    !closeGripper.

@[wotExchangable]
+!releaseObject: true <-
    !openGripper.

{ include("../wotPlans.asl") }
{ include("$jacamo/templates/common-cartago.asl") }
