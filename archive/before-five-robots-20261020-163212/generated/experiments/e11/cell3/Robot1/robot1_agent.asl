interactionSpaceNeighbor(robot3_agent, robot3).
handoverPartner(robot2_agent, robot2).
handoverPartner(robot3_agent, robot3).
interactionSpaceOwner(robot1, robot2).
interactionSpaceOwner(robot1, robot3).
